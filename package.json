{
  "name": "doefin-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "studio"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:crawlable": "node scripts/check-crawlable.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "audit": "node scripts/audit.mjs",
    "check:tools": "node --experimental-strip-types --no-warnings scripts/check-tools.mjs",
    "check:links": "node scripts/check-links.mjs",
    "glossary:migrate": "node scripts/migrate-glossary.mjs",
    "check:glossary": "node scripts/check-sanity-glossary.mjs && node scripts/check-glossary-audit-regressions.mjs",
    "check:glossary:runtime": "node scripts/check-glossary-runtime.mjs",
    "editorial:migrate": "node scripts/migrate-editorial.mjs",
    "check:editorial:schema": "node scripts/check-editorial-schema-import.mjs",
    "check:editorial": "node scripts/check-editorial.mjs",
    "check:editorial:runtime": "node scripts/check-editorial-runtime.mjs",
    "docs:migrate": "node scripts/migrate-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:schema": "node scripts/check-docs-schema-import.mjs",
    "check:docs:runtime": "node scripts/check-docs-runtime.mjs",
    "guides:migrate": "node scripts/migrate-tool-guides.mjs",
    "check:guides": "node scripts/check-tool-guides.mjs",
    "check:guides:runtime": "node scripts/check-tool-guides-runtime.mjs",
    "check:home-faq": "node scripts/check-home-faq.mjs",
    "about-authors:migrate": "node scripts/migrate-about-authors.mjs",
    "check:about-authors": "node scripts/check-about-authors.mjs",
    "check:research-methodology": "node scripts/check-research-methodology.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "brand:sync": "node scripts/brand-sync.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@sanity/client": "8.11.0",
    "@sanity/ui": "4.4.10",
    "next": "^16.3.3",
    "next-sanity": "13.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.20.0",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7"
  }
}
