{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "dom"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"], "exclude": ["node_modules", "dist"]
}
