{
  "version": 2,
  "about": "Doefin copy rules. kind=cut: generated-sounding phrasing, remove or rewrite. kind=check: Matteo or the compliance approver must see it. kind=style: house style. Patterns are case-insensitive regular expressions unless case_sensitive is true. A rule with except: [channels] does not apply on those channels (web, app, social, email, deck, doc).",
  "max_sentence_words": 30,
  "channels": ["web", "app", "social", "email", "deck", "doc"],
  "rules": [
    {"kind": "cut", "match": "\\bdelv(e|es|ed|ing)\\b", "say": "look at"},
    {"kind": "cut", "match": "\\bleverag(e|es|ed|ing)\\b", "say": "use (keep it only if you mean borrowed money)"},
    {"kind": "cut", "match": "\\butili[sz](e|es|ed|ing|ation)\\b", "say": "use"},
    {"kind": "cut", "match": "\\bseamless(ly)?\\b", "say": "say what is easy, e.g. 'in two steps'"},
    {"kind": "cut", "match": "\\brobust\\b", "say": "say what it withstands"},
    {"kind": "cut", "match": "\\b(cutting[- ]edge|state[- ]of[- ]the[- ]art|next[- ]gen(eration)?|best[- ]in[- ]class|world[- ]class)\\b", "say": "cut it and show the fact"},
    {"kind": "cut", "match": "\\b(game[- ]chang(er|ers|ing)|groundbreaking|revolution(ary|i[sz]e|i[sz]es|i[sz]ing)|transformative)\\b", "say": "cut it and say what changed"},
    {"kind": "cut", "match": "\\bunlock(s|ed|ing)?\\b", "say": "get, open, see"},
    {"kind": "cut", "match": "\\b(unleash|supercharg|skyrocket)\\w*", "say": "cut"},
    {"kind": "cut", "match": "\\bempower\\w*", "say": "let, help"},
    {"kind": "cut", "match": "\\belevat(e|es|ed|ing)\\b", "say": "raise, improve"},
    {"kind": "cut", "match": "\\bharness(es|ed|ing)?\\b", "say": "use"},
    {"kind": "cut", "match": "\\bnavigat(e|es|ing) (the|this|these|a|an|our|your)\\b", "say": "deal with, handle"},
    {"kind": "cut", "match": "\\blandscape\\b", "say": "market, or cut"},
    {"kind": "cut", "match": "\\b(realm|tapestry|testament|beacon|symphony)\\b", "say": "cut"},
    {"kind": "cut", "match": "\\b(pivotal|paramount|crucial)\\b", "say": "key, important, or cut"},
    {"kind": "cut", "match": "\\bcomprehensive\\b", "say": "full, or say what it covers"},
    {"kind": "cut", "match": "\\b(holistic|synerg\\w*|streamlin\\w*|foster\\w*|bolster\\w*)\\b", "say": "a plain verb, or cut"},
    {"kind": "cut", "match": "\\bembark\\w*", "say": "start"},
    {"kind": "cut", "match": "\\b(ever[- ]evolving|fast[- ]paced|rapidly evolving|fast[- ]evolving)\\b", "say": "cut"},
    {"kind": "cut", "match": "\\b(vibrant|intricate|multifaceted|meticulous(ly)?)\\b", "say": "cut, or be specific"},
    {"kind": "cut", "match": "\\b(moreover|furthermore|additionally)\\b", "say": "also, and"},
    {"kind": "cut", "match": "\\b(notably|essentially|ultimately|arguably)\\b", "say": "cut"},
    {"kind": "cut", "match": "\\b(myriad|plethora|numerous)\\b", "say": "give the number"},
    {"kind": "cut", "match": "\\ba wide (range|variety) of\\b|\\ba variety of\\b", "say": "give the number"},
    {"kind": "cut", "match": "\\bin order to\\b", "say": "to"},
    {"kind": "cut", "match": "\\bprior to\\b", "say": "before"},
    {"kind": "cut", "match": "\\bfacilitat\\w*", "say": "help, run"},
    {"kind": "cut", "match": "\\bcommenc\\w*", "say": "start"},
    {"kind": "cut", "match": "\\b(showcas\\w*|underscor\\w*)", "say": "show"},
    {"kind": "cut", "match": "\\b(serves as|stands as|boasts?)\\b", "say": "is, has"},
    {"kind": "cut", "match": "\\b(it'?s|it is) (worth noting|important to note|worth mentioning)\\b", "say": "cut it and just say the thing"},
    {"kind": "cut", "match": "\\bneedless to say\\b", "say": "cut"},
    {"kind": "cut", "match": "\\bin today'?s\\b", "say": "cut the scene-setting"},
    {"kind": "cut", "match": "\\bin the (world|realm) of\\b", "say": "cut"},
    {"kind": "cut", "match": "\\bwhen it comes to\\b", "say": "for, on"},
    {"kind": "cut", "match": "\\bat the end of the day\\b", "say": "cut"},
    {"kind": "cut", "match": "\\b(dive|delve) into\\b|\\bdeep[- ]dive\\b", "say": "look at"},
    {"kind": "cut", "match": "\\blet'?s (dive|explore|break|unpack)\\b", "say": "cut"},
    {"kind": "cut", "match": "\\bwhether you'?re\\b", "say": "write to one reader"},
    {"kind": "cut", "match": "\\b(look no further|rest assured|say goodbye to|to the next level|ahead of the curve|the power of)\\b", "say": "cut"},
    {"kind": "cut", "match": "\\b(in conclusion|in summary|to sum up|key takeaways?)\\b", "say": "cut it and end on the point"},
    {"kind": "cut", "match": "\\b(here'?s the thing|the truth is|let that sink in|spoiler|buckle up)\\b", "say": "cut"},
    {"kind": "cut", "match": "\\bdemocrati[sz]\\w*", "say": "open up, or cut"},
    {"kind": "cut", "match": "\\b(thrilled|excited|delighted) to (announce|share|introduce)\\b", "say": "just say it"},
    {"kind": "cut", "match": "\\bhope (this|you)( email)? (finds|are|is) (you )?(well|doing well)\\b", "say": "start with why you are writing"},
    {"kind": "cut", "match": "\\b(just following up|wanted to reach out|reaching out|quick question|circle back|touch base)\\b", "say": "start with the point"},
    {"kind": "cut", "match": "\\b(to the moon|lfg|wagmi|degen)\\b", "say": "cut"},
    {"kind": "check", "match": "\\b((?<!not )(?<!n't )(?<!n’t )guarantee\\w*|risk[- ]free|no risk|can'?t lose|safe bet)\\b", "say": "a promise of outcome: never"},
    {"kind": "check", "match": "\\b(returns?|profit\\w*|earn(s|ed|ing)?|yield\\w*|passive income)\\b", "say": "return or profit language: only in an illustrative worked example that shows the loss too; Matteo reviews financial examples"},
    {"kind": "check", "match": "\\banyone can (trade|invest|buy|sell|join|use|access|start|get|profit)\\b|\\b(for everyone|accessible to everyone|beginners?|retail|newbies?)\\b", "say": "reads as retail; Doefin is for professional investors only"},
    {"kind": "check", "match": "\\b(bet|bets|betting|wager\\w*|gambl\\w*|odds)\\b", "say": "gambling language; say position or price"},
    {"kind": "check", "match": "\\b(hashrate derivatives?|prediction markets?|derivatives? platform)\\b", "say": "category label; wait for counsel and describe the mechanism"},
    {"kind": "check", "match": "\\b(ai[- ]powered|powered by ai|ai[- ]driven)\\b", "say": "don't claim AI; difficulty forecasting is arithmetic"},
    {"kind": "check", "match": "\\b(miners|funds|lenders|clients|customers|desks)\\s+(already\\s+)?(hedge|hedging|are hedging|use|are using|trade|are trading)\\b[^.\\n]{0,40}\\b(doefin|with us|our markets)\\b", "say": "a claim about customers: name them only if it is true and they agreed; otherwise say what Doefin lets them do"},
    {"kind": "check", "match": "\\b(act now|don'?t miss|limited time|last chance|hurry)\\b", "say": "urgency; not allowed"},
    {"kind": "check", "match": "\\b(Raffaella|Tenconi)\\b", "say": "not part of Doefin; remove the name (see decisions.md)"},
    {"kind": "check", "match": "\\b(UK[- ]based|UK company|UK entity|Predexyo UK|under UK law|British company)\\b", "say": "Doefin is registered in Port Louis, Mauritius; check the entity wording before it goes out"},
    {"kind": "check", "match": "\\b(world'?s first|first[- ]ever|number one|the (first|only|largest|leading|biggest) ([\\w-]+ ){0,3}(market|markets|platform|exchange|venue|protocol|product|company|marketplace))\\b", "say": "a superlative claim needs evidence on file"},
    {"kind": "check", "match": "\\b(native yield|protect(s|ing)? (all|your|their) (revenues?|income|production)|fully hedg\\w*|hedg\\w* (all|every) risks?|eliminat\\w* (your |the |all |any )?risks?|(?<!not )(?<!n't )(?<!n’t )covers? every (mining )?risk)\\b", "say": "an unqualified promise Matteo never wants: say what a position may offset and what it does not cover"},
    {"kind": "style", "match": "\\b(I|you|we|they|he|she)['’](m|re|ve|d|ll)\\b|\\b(it|that|there|here|what|who|where|how|he|she)['’]s\\b|\\b(do|does|did|is|are|was|were|have|has|had|would|should|could|must|need)n['’]t\\b|\\b(can|won|shan)['’]t\\b|\\blet['’]s\\b", "say": "no contractions: write it out (I am, do not, there is), Matteo's rule"},
    {"kind": "style", "match": "\\bmarkets for bitcoin mining difficulty\\b", "say": "old one-liner; now 'Trade and hedge Bitcoin hashrate exposure through markets on mining difficulty.'"},
    {"kind": "style", "match": "\\bpositions involve risk\\b", "say": "old disclaimer; now 'You can lose the full amount paid for a position.'"},
    {"kind": "style", "match": "\\b(open|launch) (the )?app\\b", "say": "the app button says 'Enter app'"},
    {"kind": "style", "match": "\\b(fewer|more|less) coins\\b", "say": "say expected BTC production, with 'at the same hashrate, all else equal'"},
    {"kind": "style", "match": "\\bretargets?\\b", "say": "say difficulty adjustment (seen in Matteo's edits)"},
    {"kind": "style", "match": "\\bexpiry block\\b", "say": "say settlement block or the specified block (seen in Matteo's edits)"},
    {"kind": "style", "match": "\\bstrikes?\\b", "say": "customer copy says threshold (seen in Matteo's edits)"},
    {"kind": "style", "match": "\\bposition tokens?\\b", "say": "say shares; explain once that they are position tokens"},
    {"kind": "style", "case_sensitive": true, "match": "\\b(YES|NO)\\b", "say": "never 'YES/NO position'; Yes and No in sentence case name the sides; in marketing copy describe the position ('a position that pays out if difficulty is above X')"},
    {"kind": "style", "case_sensitive": true, "match": "\\b\\d[\\d,]*(\\.\\d+)?\\s+T\\b", "say": "no space before T: 140.58T"},
    {"kind": "style", "case_sensitive": true, "match": "(^|[^/@.\\w-])bitcoin\\b(?![./_-]\\w)", "say": "Bitcoin with a capital B"},
    {"kind": "style", "match": "\\s—\\s|\\w—\\w", "say": "no em dashes; use a full stop or a comma"},
    {"kind": "style", "match": "!", "say": "no exclamation marks on the website, in the app, email or documents (fine on social when it fits)", "except": ["social"]},
    {"kind": "style", "match": "[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}\\u{2B50}\\u{2705}]", "say": "no emoji on the website, in the app, email or documents (fine on social when it fits)", "except": ["social"]},
    {"kind": "style", "match": "(^|\\s)#(?![0-9A-Fa-f]{3,8}\\b)[A-Za-z]\\w+", "say": "no hashtags"},
    {"kind": "style", "match": "\\bnot (just|only|merely)\\b[^.?!\\n]{0,60}\\bbut\\b", "say": "'not just X but Y': say Y"},
    {"kind": "style", "match": "\\b(it'?s|this is) not [^.?!\\n]{1,40}[.,;]\\s*(it'?s|this is)\\b", "say": "'It's not X, it's Y': say Y"},
    {"kind": "style", "match": "\\?\\s+(the answer|simple|here'?s)\\b", "say": "don't ask and answer; make the statement"}
  ]
}
